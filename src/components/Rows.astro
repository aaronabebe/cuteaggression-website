---
// The date-then-title list used by shows, back catalogue and the news sidebar.
// Rows with a link are clickable, rows without are plain — same shape either way.
export interface Row {
	meta: string;
	title: string;
	href?: string;
}

interface Props {
	items: Row[];
	/** date above the title instead of beside it — for the narrow sidebar */
	stacked?: boolean;
	/** smaller type, also for the sidebar */
	tight?: boolean;
}

const { items, stacked = false, tight = false } = Astro.props;
---

<div class:list={['rows', { tight }]}>
	{
		items.map((item) => {
			const Tag = item.href ? 'a' : 'div';
			return (
				<Tag class:list={['row', { stacked }]} href={item.href}>
					<span class="mono">{item.meta}</span>
					<span>{item.title}</span>
				</Tag>
			);
		})
	}
</div>

<style>
	.rows {
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin-bottom: 10px;
	}

	/* list rows are full width, so the shared a:hover scale would make them overlap */
	.row {
		display: flex;
		gap: 12px;
		align-items: baseline;
		margin: 0;
		padding: 7px 10px;
		border: 2px solid var(--secondary);
		background: var(--paper);
	}

	.row.stacked {
		flex-direction: column;
		gap: 0;
		line-height: 1.4;
	}

	a.row:hover {
		transform: none;
		background: var(--primary);
		color: var(--secondary);
	}

	.tight .row {
		font-size: 0.95em;
	}
</style>
