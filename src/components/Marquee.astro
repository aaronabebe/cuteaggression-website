---
// The scrolling bar. Used for the news ticker, the webring strip and the
// under-construction sign — same machinery, different paint.
interface Props {
	/** how long one pass takes. longer text wants a longer duration */
	speed?: number;
	/** gif bookends, e.g. "/flame.gif". left alone when omitted */
	gif?: string;
	/** alert = yellow news ticker, ring = cyan band-name strip */
	variant?: 'alert' | 'ring';
}

const { speed = 20, gif, variant = 'alert' } = Astro.props;
---

<div class:list={['marquee', variant]}>
	{gif && <img src={gif} alt="" aria-hidden="true" class="bookend" />}
	<div class="track">
		<span style={`animation-duration: ${speed}s`}>
			<slot />
		</span>
	</div>
	{gif && <img src={gif} alt="" aria-hidden="true" class="bookend" />}
</div>

<style>
	.marquee {
		display: flex;
		align-items: center;
		gap: 6px;
		border: 4px solid var(--secondary);
		overflow: hidden;
		margin: 0 0 22px;
		padding: 6px;
		font-size: 1.1rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		text-transform: uppercase;
	}

	.alert {
		background: var(--alert);
	}

	.ring {
		background: var(--tertiary);
		font-size: 0.95rem;
	}

	/* the text has to scroll inside its own box, or the gifs scroll away with it */
	.track {
		flex: 1;
		overflow: hidden;
	}

	.track > span {
		display: inline-block;
		white-space: nowrap;
		padding-left: 100%;
		animation: ticker-slide linear infinite;
	}

	.bookend {
		height: 26px;
		width: auto;
		flex: none;
	}

	@keyframes ticker-slide {
		to {
			transform: translateX(-100%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.track > span {
			animation: none;
			padding-left: 0;
			white-space: normal;
		}
	}
</style>
