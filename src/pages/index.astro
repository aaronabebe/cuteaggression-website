---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { spotifyEmbed, youtubeEmbed, bandcampEmbed } from '../lib/embed.ts';

const byNewest = (a: { data: { date: Date } }, b: { data: { date: Date } }) =>
	b.data.date.valueOf() - a.data.date.valueOf();

const links = (await getCollection('links')).sort((a, b) => a.data.order - b.data.order);
const news = (await getCollection('news')).sort(byNewest);
const releases = (await getCollection('releases')).sort(byNewest);
const videos = (await getCollection('videos')).sort(byNewest);

const fmt = new Intl.DateTimeFormat('de-AT', { day: '2-digit', month: '2-digit', year: 'numeric' });

const label: Record<string, string> = {
	concert: 'concert',
	single: 'new single',
	album: 'new album',
	video: 'new video',
	press: 'press',
	charts: 'charts',
};
---

<Layout>
	<main>
		<h1>cute aggression</h1>

		<div class="social-links">
			{links.map((link) => <a href={link.data.url}>{link.data.text}</a>)}
			<a href="/links">links</a>
		</div>

		<div class="bio">
			<p>
				cute aggression make music. music that you like. or don’t. to cute aggression that
				doesn’t matter. come by when cute aggression play a concert. they play synthesizers
				and drum machines and guitars and stuff. or maybe they don’t. maybe they just play
				with your expectations.
			</p>
			<p>our debut album <b>make us crash</b> is out now.</p>
			<p>currently recording our first ep. out this fall.</p>
			<p><b>XOXO</b></p>
		</div>

		{
			releases.length > 0 && (
				<>
					<h2>listen</h2>
					<div class="stack">
						{releases.map(({ data }) => {
							const spotify = spotifyEmbed(data.spotify);
							const bandcamp = bandcampEmbed(data.bandcampId);
							return (
								<div class="card release">
									<h3>{data.title}</h3>
									{spotify && (
										<iframe
											src={spotify}
											height={data.kind === 'album' ? 352 : 152}
											loading="lazy"
											title={data.title}
											allow="encrypted-media; clipboard-write; fullscreen; picture-in-picture"
										/>
									)}
									{bandcamp && (
										<iframe src={bandcamp} height="120" loading="lazy" title={data.title} seamless />
									)}
									<div>
										{data.bandcampUrl && <a href={data.bandcampUrl}>bandcamp</a>}
										{data.links.map((l) => (
											<a href={l.url}>{l.text}</a>
										))}
									</div>
								</div>
							);
						})}
					</div>
				</>
			)
		}

		{
			videos.length > 0 && (
				<>
					<h2>watch</h2>
					<div class="stack">
						{videos.map(({ data }) => (
							<div class="card video">
								<h3>{data.title}</h3>
								<div class="video-frame">
									<iframe
										src={youtubeEmbed(data.youtube) ?? data.youtube}
										loading="lazy"
										title={data.title}
										allow="accelerometer; encrypted-media; picture-in-picture; web-share"
										allowfullscreen
									/>
								</div>
							</div>
						))}
					</div>
				</>
			)
		}

		<h2>news</h2>
		<div class="stack">
			{
				news.map(({ data }) => (
					<div class:list={['card', 'news-item', { single: data.kind !== 'concert' }]}>
						<p>{data.dateLabel ?? fmt.format(data.date)}</p>
						<h3>
							<b>{label[data.kind]}: </b>
							{data.title}
						</h3>
						<div>
							{data.links.map((l) => (
								<a href={l.url}>{l.text}</a>
							))}
						</div>
					</div>
				))
			}
		</div>
		<footer>website by aaron abebe</footer>
	</main>
</Layout>

<style>
	.bio {
		background: var(--primary);
	}

	.stack {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.card {
		padding-top: 1rem;
		padding-bottom: 10px;
		width: 100%;
		text-align: center;
		background: var(--primary);
	}

	.news-item {
		border-bottom: 2px dashed;
	}

	.single {
		background: var(--tertiary);
	}

	.release,
	.video {
		background: var(--tertiary);
		border-bottom: 2px dashed;
	}

	iframe {
		border: 0;
		width: 100%;
		display: block;
		margin-bottom: 10px;
	}

	/* keeps youtube 16:9 without javascript */
	.video-frame {
		aspect-ratio: 16 / 9;
	}

	.video-frame iframe {
		height: 100%;
	}

	@media screen and (min-width: 600px) {
		.card {
			width: 60%;
		}

		.stack {
			width: 100%;
		}
	}
</style>
