---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Marquee from '../components/Marquee.astro';
import Embed from '../components/Embed.astro';
import Footer from '../components/Footer.astro';
import Rows from '../components/Rows.astro';
import type { Row } from '../components/Rows.astro';

const byNewest = (a: { data: { date: Date } }, b: { data: { date: Date } }) =>
	b.data.date.valueOf() - a.data.date.valueOf();

const links = (await getCollection('links')).sort((a, b) => a.data.order - b.data.order);
const news = (await getCollection('news')).sort(byNewest);
const releases = (await getCollection('releases')).sort(byNewest);
const videos = (await getCollection('videos')).sort(byNewest);

const fmt = new Intl.DateTimeFormat('de-AT', { day: '2-digit', month: '2-digit', year: 'numeric' });
const shortFmt = new Intl.DateTimeFormat('de-AT', { day: '2-digit', month: '2-digit' });

const label: Record<string, string> = {
	concert: 'concert',
	single: 'new single',
	album: 'new album',
	video: 'new video',
	press: 'press',
	charts: 'charts',
	award: 'award',
};

// anything from the last 30 days wears the NEW badge, so it expires on its own
const DAY = 86_400_000;
const isNew = (d: Date) => Date.now() - d.valueOf() < 30 * DAY;

const album = releases.find((r) => r.data.kind === 'album');
const latestSingle = releases.find((r) => r.data.kind !== 'album');
const backCatalogue = releases.filter((r) => r !== album && r !== latestSingle);

const charts = news.find((n) => n.data.kind === 'charts');
const award = news.find((n) => n.data.kind === 'award');
const pullQuote = news.find((n) => n.data.kind === 'press' && n.data.quote && n.data.outlet);
const press = news.filter((n) => n.data.kind === 'press');

// the ticker leads with the two things worth shouting about, then whatever is newest
const shouted = [charts, award].filter((n) => n !== undefined);
const ticker = [...shouted, ...news.filter((n) => !shouted.includes(n))].slice(0, 6);

// gigs that haven't happened yet belong at the top, soonest first — everything
// else is history. `date` is midnight, so compare against midnight today.
const today = new Date().setHours(0, 0, 0, 0);
const shows = news.filter((n) => n.data.kind === 'concert');
const upcoming = shows.filter((s) => s.data.date.valueOf() >= today).reverse();
const played = shows.filter((s) => s.data.date.valueOf() < today);
const recentShows = played.slice(0, 6);
const oldShows = played.slice(6);
const recent = news.slice(0, 5);

const showRow = ({ data }: (typeof shows)[number]): Row => ({
	meta: data.dateLabel ?? fmt.format(data.date),
	title: data.title,
	href: data.links[0]?.url,
});

const releaseRow = ({ data }: (typeof releases)[number]): Row => ({
	meta: fmt.format(data.date),
	title: data.title,
	href: data.spotify ?? data.bandcampUrl ?? data.links[0]?.url,
});
---

<Layout description="cute aggression — vienna. debut album make us crash out now.">
	<main>
		<h1>cute aggression</h1>

		<nav class="linkbar">
			{/* the streaming links live on /links now — the bar only keeps the rest */}
			{links.filter((l) => !l.data.featured).map((l) => <a href={l.data.url}>{l.data.text}</a>)}
			<a href="/links">♥ all the links ♥</a>
		</nav>

		<Marquee gif="/flame.gif" speed={28}>
			{ticker.map((n) => `>>> ${label[n.data.kind]}: ${n.data.title} `)}{'<<<'}
		</Marquee>

		<div class="grid">
			<div>
				{
					album && (
						<section class="panel hero tinted">
							{isNew(album.data.date) && <p class="badge blink">★ NEW ★</p>}
							<h2>out now</h2>
							<div class="hero-body">
								{album.data.cover && (
									<img
										class="cover"
										src={album.data.cover}
										alt={`${album.data.title} album cover`}
										width="640"
										height="640"
									/>
								)}
								<div>
									<h3 class="hero-title">{album.data.title}</h3>
									<p class="mono meta">debut album · {fmt.format(album.data.date)}</p>
									<div class="hero-links">
										{album.data.spotify && <a href={album.data.spotify}>spotify</a>}
										{album.data.bandcampUrl && <a href={album.data.bandcampUrl}>bandcamp</a>}
										{album.data.links.map((l) => (
											<a href={l.url}>{l.text}</a>
										))}
									</div>
								</div>
							</div>
						</section>
					)
				}

				<div class="divider"></div>

				{
					upcoming.length > 0 && (
						<section class="panel next tinted">
							<h2>next</h2>
							<p class="mono blink soon">▶ ▶ ▶ come by</p>
							<Rows items={upcoming.map(showRow)} />
						</section>
					)
				}

				{
					pullQuote && (
						<section class="panel quote-panel tinted">
							<h2>press</h2>
							<blockquote>„{pullQuote.data.quote}“</blockquote>
							<p class="mono attrib">— {pullQuote.data.outlet}</p>
							<div>
								{press.flatMap((p) =>
									p.data.links.map((l) => <a href={l.url}>{p.data.outlet ?? p.data.title.split(':')[0]}</a>),
								)}
								<a href="https://drive.google.com/drive/folders/1GwIzbjxxkbSLlQfv0d8AmRoVmMlS_AN2">press kit</a>
							</div>
						</section>
					)
				}

				<div class="divider"></div>

				<section class="panel">
					<h2>listen</h2>
					{
						latestSingle && (
							<>
								<h3>{latestSingle.data.title}</h3>
								<p class="mono meta">latest single · {fmt.format(latestSingle.data.date)}</p>
								<Embed url={latestSingle.data.spotify} title={latestSingle.data.title} />
								<Embed url={latestSingle.data.bandcampId} title={latestSingle.data.title} />
							</>
						)
					}
					{
						backCatalogue.length > 0 && (
							<details>
								<summary>everything else ({backCatalogue.length})</summary>
								<Rows items={backCatalogue.map(releaseRow)} />
							</details>
						)
					}
				</section>

				{
					videos.length > 0 && (
						<section class="panel">
							<h2>watch</h2>
							{videos.map(({ data }) => (
								<>
									<h3>{data.title}</h3>
									<Embed url={data.youtube} title={data.title} />
								</>
							))}
						</section>
					)
				}

				<section class="panel shows">
					<h2>played</h2>
					<Rows items={recentShows.map(showRow)} />
					{
						oldShows.length > 0 && (
							<details>
								<summary>the full ancient history ({oldShows.length})</summary>
								<Rows items={oldShows.map(showRow)} />
							</details>
						)
					}
				</section>
			</div>

			<aside>
				<section class="panel side">
					<h2>new</h2>
					<Rows
						stacked
						tight
						items={recent.map(({ data }) => ({
							meta: `${data.dateLabel ?? shortFmt.format(data.date)} · ${label[data.kind]}`,
							title: data.title,
						}))}
					/>
				</section>

				<section class="panel side about">
					<h2>about</h2>
					<p>
						cute aggression make music. music that you like. or don’t. to cute aggression
						that doesn’t matter. come by when cute aggression play a concert. they play
						synthesizers and drum machines and guitars and stuff. or maybe they don’t.
						maybe they just play with your expectations.
					</p>
					<p>currently recording our first ep. out this fall.</p>
					<p><b>XOXO</b></p>
				</section>
			</aside>
		</div>

		<Footer />
	</main>
</Layout>

<style>
	.linkbar {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		background: var(--primary);
		border: 4px solid var(--secondary);
		border-top: 0;
		padding: 10px;
		margin-bottom: 22px;
	}

	.linkbar a {
		margin: 0;
		flex: 1 1 auto;
		text-align: center;
	}

	.grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0 22px;
	}

	.hero {
		background: var(--tertiary);
		position: relative;
	}

	.hero-title {
		font-size: clamp(1.6rem, 7vw, 3rem);
		line-height: 1;
	}

	/* cover beside the text on wide screens, stacked on phones. both children get a
	   flex basis so they share the row instead of one wrapping and leaving a gap. */
	.hero-body {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		align-items: flex-start;
	}

	.hero-body > div {
		flex: 3 1 200px;
		min-width: 0;
	}

	.cover {
		flex: 1 1 170px;
		/* an image's automatic minimum size is its intrinsic 640px, which would push
		   the text off the row no matter how small the basis is */
		min-width: 0;
		max-width: 240px;
		height: auto;
		display: block;
		border: 3px solid var(--secondary);
		box-shadow: 5px 5px 0 var(--secondary);
	}

	.hero-links {
		padding-top: 4px;
	}

	.hero-links a {
		font-size: 1.05em;
		background: var(--primary);
	}

	.hero-links a:hover {
		background: var(--alert);
		color: var(--secondary);
	}

	.badge {
		position: absolute;
		top: -14px;
		right: -6px;
		background: var(--alert);
		border: 3px solid var(--secondary);
		font-size: 1rem;
		font-weight: 700;
		padding: 2px 8px;
	}

	.next {
		background: var(--accent);
	}

	.soon {
		padding: 0 0 8px;
		letter-spacing: 0.1em;
	}

	.meta {
		font-size: 0.85em;
		padding-bottom: 10px;
	}

	.quote-panel {
		background: var(--alert);
	}

	blockquote {
		font-size: clamp(1.1rem, 4.4vw, 1.9rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.15;
		text-transform: uppercase;
		margin: 0;
		padding: 4px 0;
	}

	.attrib {
		font-size: 0.9em;
		padding-bottom: 12px;
	}

	summary {
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		background: var(--tertiary);
		border: 2px solid var(--secondary);
		padding: 5px 10px;
		width: fit-content;
		cursor: pointer;
	}

	summary:hover {
		background: var(--paper);
	}

	details[open] summary {
		margin-bottom: 10px;
	}

	.about p {
		font-size: 0.95em;
	}

	@media screen and (min-width: 900px) {
		.grid {
			grid-template-columns: minmax(0, 1fr) 300px;
		}

		.side {
			padding: 12px;
		}
	}
</style>
