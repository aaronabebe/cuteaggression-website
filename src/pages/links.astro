---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const links = (await getCollection('links')).sort((a, b) => a.data.order - b.data.order);
const featured = links.filter((l) => l.data.featured);
const rest = links.filter((l) => !l.data.featured);

// newest release gets the top slot — that's what an instagram bio link is for
const [latest] = (await getCollection('releases')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latestUrl = latest?.data.spotify ?? latest?.data.bandcampUrl ?? latest?.data.links[0]?.url;
---

<Layout title="cute aggression — links" description="all the cute aggression links in one place">
	<main>
		<h1>cute aggression</h1>

		<div class="tree">
			{latestUrl && <a class="big latest" href={latestUrl}>♥ new: {latest.data.title} ♥</a>}
			{featured.map((l) => <a class="big" href={l.data.url}>{l.data.text}</a>)}
			{rest.map((l) => <a class="big small" href={l.data.url}>{l.data.text}</a>)}
			<a class="big small" href="/">the whole website</a>
		</div>

		<footer>website by aaron abebe</footer>
	</main>
</Layout>

<style>
	.tree {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 10px 0 30px;
		/* a linktree is a phone-shaped thing — don't let it stretch to the full page */
		max-width: 460px;
		margin: 0 auto;
	}

	/* override the shared inline-block link style — these are full-width tap targets */
	.big {
		margin-right: 0;
		display: block;
		text-align: center;
		font-size: 1.4rem;
		padding: 18px 10px;
		text-decoration: none;
	}

	.big:hover {
		/* the shared scale(1.2) makes stacked full-width buttons overlap */
		transform: none;
		outline: 4px solid var(--secondary);
	}

	.latest {
		background: var(--primary);
		font-style: italic;
	}

	.latest:hover {
		background: var(--tertiary);
		color: var(--secondary);
	}

	.small {
		font-size: 1rem;
		padding: 12px 10px;
	}
</style>
