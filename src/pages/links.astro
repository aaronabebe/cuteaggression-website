---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Marquee from '../components/Marquee.astro';
import Embed from '../components/Embed.astro';
import Footer from '../components/Footer.astro';

const links = (await getCollection('links')).sort((a, b) => a.data.order - b.data.order);
const featured = links.filter((l) => l.data.featured);
const rest = links.filter((l) => !l.data.featured);

// newest release gets the top slot — that's what an instagram bio link is for
const [latest] = (await getCollection('releases')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latestUrl = latest?.data.spotify ?? latest?.data.bandcampUrl ?? latest?.data.links[0]?.url;

const [latestVideo] = (await getCollection('videos')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// an icon is either an emoji or a path to one of the gifs in public/
const isGif = (icon: string | undefined) => icon?.startsWith('/');
---

<Layout title="cute aggression — links" description="all the cute aggression links in one place">
	<main>
		<h1>cute aggression</h1>

		<Marquee variant="ring" gif="/flame2.gif" speed={14}>
			♥ cute aggression ♥ vienna ♥ hyperpop ♥ electropunk ♥ cute aggression ♥ vienna ♥
			hyperpop ♥ electropunk ♥
		</Marquee>

		<div class="tree">
			{
				latest && (
					<section class="now">
						<p class="mono nowlabel blink">♫ now playing ♫</p>
						<h2 class="nowtitle">{latest.data.title}</h2>
						<Embed url={latest.data.spotify} title={latest.data.title} size="mini" eager />
						{/* the title is right above — repeating it here just wraps to two lines */}
						{latestUrl && (
							<a class="big latest" href={latestUrl}>
								♥ listen ♥
							</a>
						)}
					</section>
				)
			}

			{
				featured.map((l) => (
					<>
						<a class="big" href={l.data.url}>
							<span class="ico">
								{isGif(l.data.icon) ? <img src={l.data.icon} alt="" aria-hidden="true" /> : l.data.icon}
							</span>
							<span class="txt">
								{l.data.text}
								{l.data.note && <em class="note">{l.data.note}</em>}
							</span>
						</a>
						<Embed url={l.data.embed} title={l.data.text} />
					</>
				))
			}

			{
				rest.map((l) => (
					<a class="big small" href={l.data.url}>
						<span class="ico">{l.data.icon}</span>
						<span class="txt">
							{l.data.text}
							{l.data.note && <em class="note">{l.data.note}</em>}
						</span>
					</a>
				))
			}

			{
				latestVideo && (
					<section class="now video">
						<p class="mono nowlabel">📺 latest video 📺</p>
						<h2 class="nowtitle">{latestVideo.data.title}</h2>
						<Embed url={latestVideo.data.youtube} title={latestVideo.data.title} />
					</section>
				)
			}

			<a class="big small" href="/">
				<span class="ico">🌐</span>
				<span class="txt">the whole website</span>
			</a>

			<button class="big small share" type="button" data-share>
				<span class="ico">📎</span>
				<span class="txt">copy this link</span>
			</button>
		</div>

		<Footer />
	</main>
</Layout>

<script is:inline>
	// share sheet on phones, clipboard everywhere else. no library, no fallback ui —
	// the button just says what happened.
	document.querySelector('[data-share]')?.addEventListener('click', async function () {
		const label = this.querySelector('.txt');
		const before = label.textContent;
		try {
			if (navigator.share) {
				await navigator.share({ title: 'cute aggression', url: location.href });
				return;
			}
			await navigator.clipboard.writeText(location.href);
			label.textContent = 'copied !!!';
		} catch (e) {
			// user dismissed the share sheet, or the browser refused the clipboard
			if (e && e.name === 'AbortError') return;
			label.textContent = location.href;
		}
		setTimeout(() => (label.textContent = before), 2000);
	});
</script>

<style>
	.tree {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 10px 0 30px;
		/* a linktree is a phone-shaped thing — don't let it stretch to the full page */
		max-width: 460px;
		margin: 0 auto;
	}

	.now {
		background: var(--primary);
		border: 4px double var(--secondary);
		box-shadow: 6px 6px 0 var(--secondary);
		padding: 12px;
		transform: rotate(-0.8deg);
	}

	.now.video {
		background: var(--accent);
		transform: rotate(0.6deg);
		box-shadow: -6px 6px 0 var(--secondary);
	}

	.nowlabel {
		padding: 0;
		letter-spacing: 0.12em;
	}

	/* the global h2 wears a box and ** asterisks ** — too much inside a panel
	   that already shouts. this one is just big text. */
	.nowtitle {
		font-size: 1.2rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		background: none;
		border: 0;
		width: auto;
		padding: 0;
		margin: 0 0 10px;
	}

	.nowtitle::before,
	.nowtitle::after {
		content: '';
	}

	/* override the shared inline-block link style — these are full-width tap targets */
	.big {
		margin-right: 0;
		display: flex;
		align-items: center;
		gap: 12px;
		width: 100%;
		/* without this the 14px padding and 2px border are added on top of the 100%,
		   pushing every button past the right edge of the screen */
		box-sizing: border-box;
		font-family: inherit;
		font-size: 1.4rem;
		text-align: left;
		padding: 16px 14px;
		text-decoration: none;
		box-shadow: 5px 5px 0 var(--secondary);
	}

	/* Every button leans a different way, like stickers stuck on by hand.
	   Scoped to direct children so the buttons *inside* a panel keep their own paint. */
	.tree > .big:nth-child(3n) {
		transform: rotate(-1deg);
		background: var(--alert);
	}
	.tree > .big:nth-child(3n + 1) {
		transform: rotate(0.8deg);
	}
	.tree > .big:nth-child(3n + 2) {
		transform: rotate(-0.3deg);
	}

	.tree > .big:nth-child(2n) {
		background: var(--accent);
	}

	.big:hover {
		/* the shared scale(1.2) makes stacked full-width buttons overlap */
		transform: rotate(0deg) translate(-2px, -2px);
		box-shadow: 9px 9px 0 var(--secondary);
		outline: 4px solid var(--secondary);
	}

	.ico {
		font-size: 1.6rem;
		line-height: 1;
		flex: none;
	}

	.ico img {
		height: 34px;
		width: auto;
		display: block;
	}

	.txt {
		display: flex;
		flex-direction: column;
		line-height: 1.15;
	}

	.note {
		font-size: 0.55em;
		font-style: normal;
		font-weight: 400;
		text-transform: none;
		letter-spacing: 0;
	}

	.latest {
		background: var(--tertiary);
		font-style: italic;
		font-size: 1.1rem;
		justify-content: center;
		text-align: center;
		margin-top: 4px;
	}

	.small {
		font-size: 1rem;
		padding: 12px;
	}

	.small .ico {
		font-size: 1.2rem;
	}

	/* the share button is a <button>, so it needs the link paint applied by hand */
	.share {
		color: var(--secondary);
		background: var(--tertiary);
		border: 2px solid var(--secondary);
		font-weight: 700;
		cursor: pointer;
	}

	.share:hover {
		color: var(--tertiary);
		background: var(--primary);
	}

	/* the whole tree is sized for a phone held at arm's length, not a desktop column */
	@media screen and (max-width: 600px) {
		.tree {
			gap: 12px;
		}

		.big {
			font-size: 1.1rem;
			padding: 13px 12px;
			gap: 10px;
		}

		.ico {
			font-size: 1.3rem;
		}

		.ico img {
			height: 26px;
		}

		.small {
			font-size: 0.95rem;
			padding: 11px 12px;
		}

		.small .ico {
			font-size: 1.05rem;
		}

		.now {
			padding: 10px;
		}

		.nowtitle {
			font-size: 1.05rem;
		}

		.latest {
			font-size: 1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.big,
		.big:hover,
		.now,
		.now.video {
			transform: none;
		}
	}
</style>
