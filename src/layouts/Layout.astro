---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'cute aggression',
	description = 'Official website of cute aggression',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/heart.gif" />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<script is:inline>
	// clicking a link stains the page and waits, then goes. the tab has to be opened
	// inside the click itself — opening it after the delay gets eaten by popup blockers.
	document.addEventListener('click', function (event) {
		if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

		const link = event.target.closest('a');
		if (!link || !link.href || link.dataset.plain !== undefined) return;

		const external = link.protocol.startsWith('http') && link.origin !== location.origin;
		const tab = external ? window.open('', '_blank') : null;
		if (external && !tab) return; // blocked: let the browser handle the click normally

		event.preventDefault();
		document.documentElement.style.background = "url('/fireskull.gif')";
		document.documentElement.style.filter = 'hue-rotate(90deg)';

		setTimeout(function () {
			if (tab) {
				tab.opener = null; // don't hand the opened site a handle on us
				tab.location = link.href;
			} else {
				location.href = link.href;
			}
		}, 800);
	});

	// A real hit counter needs a server. This one counts *your* visits, in your own
	// browser, and never leaves it — the 90s number without the 90s cgi-bin.
	try {
		var visits = Math.min(Number(localStorage.getItem('visits') || 0) + 1, 999999);
		localStorage.setItem('visits', String(visits));
		document.querySelectorAll('[data-visits]').forEach(function (el) {
			el.textContent = String(visits).padStart(6, '0');
		});
	} catch (e) {
		// private browsing blocks localStorage — the hardcoded 000001 stays put
	}
</script>

<style is:global>
	:root {
		--primary: #f0f;
		--secondary: #000;
		--tertiary: #0ff;
		--alert: #ff0;
		--accent: #7cff00;
		--paper: #fff;

		/* Verdana was drawn for 90s screens and is what most of that web actually ran on.
		   Courier only for dates, so the columns still line up. Both system fonts —
		   nothing to download, nothing extra to upload to the host. */
		--font: Verdana, Geneva, Tahoma, 'DejaVu Sans', sans-serif;
		--mono: 'Courier New', Courier, monospace;

		color: var(--secondary);
		background: url('/heart.gif');
	}

	::selection {
		color: var(--secondary);
		background: var(--tertiary);
	}

	html {
		font-family: var(--font);
		cursor: crosshair;
		scrollbar-color: var(--primary) var(--secondary);
		/* the panels are rotated, so their corners poke a few pixels past the column */
		overflow-x: hidden;
	}

	main {
		margin: auto;
		padding: 10px;
		width: min(1100px, 94%);
		font-size: 14px;
		line-height: 1.7;
	}

	h1 {
		font-size: clamp(1.3rem, 6.8vw, 3.6rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1;
		text-transform: uppercase;
		background: var(--primary);
		color: var(--secondary);
		border: 4px solid var(--secondary);
		padding: 14px 10px;
		margin: 0;
		/* misregistered print: the cyan and yellow plates land off the black one */
		text-shadow:
			4px 4px 0 var(--tertiary),
			-4px -4px 0 var(--alert);
	}

	h1:hover {
		animation: jitter 0.18s steps(2, end) infinite;
	}

	@keyframes jitter {
		0% {
			transform: translate(0, 0);
		}
		33% {
			transform: translate(-2px, 1px);
		}
		66% {
			transform: translate(2px, -1px);
		}
	}

	h2 {
		font-size: 1.4rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		background: var(--primary);
		border: 3px solid var(--secondary);
		width: fit-content;
		margin: 0 0 12px;
		padding: 2px 10px;
	}

	/* plaintext emphasis, the way section headers were marked before CSS existed */
	h2::before {
		content: '** ';
	}
	h2::after {
		content: ' **';
	}

	h3 {
		font-size: 1.1rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		margin: 0 0 4px;
	}

	p {
		margin: 0;
		padding: 6px 0;
	}

	a {
		color: var(--secondary);
		background: var(--tertiary);
		border: 2px solid var(--secondary);
		padding: 6px 10px;
		margin: 0 8px 6px 0;
		font-size: 0.95em;
		font-weight: 700;
		display: inline-block;
		text-decoration: none;
	}

	a:hover {
		color: var(--tertiary);
		background: var(--primary);
		/* browsers only draw the first frame of a gif cursor and reject anything over
		   128px, so this is a static heart. `pointer` covers the rejection. */
		cursor: url('/heart.gif') 37 37, pointer;
		transform: scale(1.1);
	}

	a:focus-visible {
		outline: 3px solid var(--alert);
		outline-offset: 2px;
	}

	/* Panels are stickers slapped on a wall, not a stack of boxes: every one sits at
	   its own angle and its own colour, and straightens up when you point at it. */
	.panel {
		background: var(--primary);
		border: 4px double var(--secondary);
		box-shadow: 6px 6px 0 var(--secondary);
		padding: 14px;
		margin-bottom: 22px;
		transform: rotate(-0.7deg);
		transition: transform 0.12s;
	}

	/* `.tinted` opts a panel out of the colour cycle so it can pick its own —
	   without it the cycle's higher specificity would override the page styles. */
	.panel:not(.tinted):nth-of-type(2n) {
		background: var(--tertiary);
		box-shadow: -6px 6px 0 var(--secondary);
	}

	.panel:not(.tinted):nth-of-type(3n) {
		background: var(--alert);
	}

	.panel:not(.tinted):nth-of-type(4n) {
		background: var(--accent);
	}

	.panel:nth-of-type(2n) {
		transform: rotate(0.5deg);
	}

	.panel:nth-of-type(3n) {
		transform: rotate(0.9deg);
	}

	.panel:nth-of-type(4n) {
		transform: rotate(-0.4deg);
	}

	.panel:hover {
		transform: rotate(0deg) translate(-2px, -2px);
		box-shadow: 10px 10px 0 var(--secondary);
	}

	/* a strip of fire between sections, tiled horizontally */
	.divider {
		height: 22px;
		margin: 0 0 22px;
		background: url('/fireskull.gif') repeat-x center / auto 22px;
		border-top: 3px solid var(--secondary);
		border-bottom: 3px solid var(--secondary);
	}

	.mono {
		font-family: var(--mono);
		font-weight: 700;
		white-space: nowrap;
	}

	.blink {
		animation: blink 1.1s steps(2, start) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.blink {
			animation: none;
		}

		a:hover,
		.panel,
		.panel:hover {
			transform: none;
		}

		h1:hover {
			animation: none;
		}
	}

	/* scrollbar */
	::-webkit-scrollbar {
		width: 10px;
	}

	::-webkit-scrollbar-track {
		background: #f1f1f1;
	}

	::-webkit-scrollbar-thumb {
		background: #888;
	}

	::-webkit-scrollbar-thumb:hover {
		background: #555;
	}

	@media screen and (min-width: 900px) {
		main {
			padding: 1rem;
			font-size: 14px;
		}

		h2 {
			font-size: 1.9rem;
		}

		h3 {
			font-size: 1.3rem;
		}
	}
</style>
